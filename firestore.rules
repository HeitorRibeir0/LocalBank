rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Lar. Apenas membros podem ler.
    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if isMember(hid);

      // Criar: só o dono, e ele precisa estar na lista de membros
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // Atualizar: membros podem alterar o lar. Limite de 5 membros e dono imutável.
      // Entrada sem ser membro bloqueada — usar /invites com hash do código.
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members.size() <= 5
        && isMember(hid);

      allow delete: if false;

      // Dados do lar (contas, transações, orçamentos, metas...): só membros
      match /{collection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }

    // Convites: gerados e usados apenas por lógica do servidor/app.
    // Cliente não pode ler/criar/deletar diretamente — validação via proof do código.
    match /invites/{code} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
