rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Lar: só membros leem. Criar, entrar e gerar convite passam pelas Cloud Functions
    // (functions/index.js), que usam o Admin SDK e ignoram estas regras.
    match /households/{hid} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;

      // Dados do lar (contas, transações, orçamentos, metas...): só membros
      match /{collection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }

    // Convites: só as Cloud Functions mexem
    match /invites/{code} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
